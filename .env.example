# Lumin-LMS environment template
#
# Copy to .env and fill in real values:  cp .env.example .env
# Keep in sync with the env vars read in src/, middleware.ts, and
# prisma/schema.prisma.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# PostgreSQL connection string, read by prisma/schema.prisma.
# Without it: `prisma db push` and `prisma migrate` fail, and any page that
# queries the database errors.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lumin_lms

# Direct (non-pooled) connection, also read by prisma/schema.prisma
# (datasource db.directUrl) and used for schema push/migrations. Same value
# as DATABASE_URL for plain local Postgres; if you use a pooled connection
# (e.g. Supabase), point this at the direct connection URL.
# Without it: Prisma fails with a missing-environment-variable error, same
# as a missing DATABASE_URL.
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/lumin_lms

# Supabase project URL (must parse as a real URL). Read in src/ and
# middleware.ts. Without it: auth pages and middleware throw on request
# (createServerClient runs in middleware on every request).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon (public) key. Read in src/ and middleware.ts.
# Without it: auth pages and middleware throw on request, same as above.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Absolute base URL of this app (no trailing slash). Read in src/
# (src/actions/auth.ts builds the post-login redirectTo for /auth/callback
# from it). Without it: the auth callback redirect resolves to
# "undefined/auth/callback" and login cannot complete.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Optional - documented in README, not currently read by any code
# ---------------------------------------------------------------------------
# Nothing under src/ or middleware.ts reads the variables below as of this
# commit; they are documented in README.md only. Uncomment and fill in when
# you wire up the corresponding integration.

# Supabase service-role key. Bypasses row-level security - server-side use
# only, never expose it to the browser.
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Stripe secret key (server-side).
# STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# Stripe publishable key (safe for the browser).
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Stripe webhook signing secret.
# STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Note: NODE_ENV is read in a few places but is managed by Next.js itself
# (development / production / test); do not set it in .env files.
